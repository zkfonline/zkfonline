# Copy to .env for local development (`netlify dev`) and set the same
# variables in the Netlify UI under Site configuration -> Environment
# variables, scoped to Functions. Real values live in
# /Users/jstudio/CLAUDE-BRAIN/projects/zkfonline/zkfonline-secrets.md
# — never in this repository, which is public.

# NOVA hub endpoint that receives support requests.
NOVA_SUPPORT_URL=https://nova.innomega.se/app/support-inbound.bxm
NOVA_SUPPORT_TOKEN=

# Website orders (Auftrag) -> NOVA enquiries. The endpoint is the ENGLISH one;
# the old anfrage-inbound.bxm is not exempt from nginx Basic Auth any more.
NOVA_ENQUIRY_URL=https://nova.innomega.se/app/enquiry-inbound.bxm
NOVA_ENQUIRY_TOKEN=

# HMAC secret for client-area magic links (32+ random bytes, base64url).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ACCESS_SECRET=

# Postmark server token for the "ZKFonline" server (outbound mail).
# Optional: without it the ticket is still created, only the mails are skipped.
POSTMARK_SERVER_TOKEN=

# Verified Postmark sender, and where the internal notification goes.
SUPPORT_FROM_EMAIL=support@zkfonline.de
SUPPORT_NOTIFY_EMAIL=support@innomega.de
